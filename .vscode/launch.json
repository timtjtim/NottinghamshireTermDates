{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: FastAPI (uvicorn)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "app.main:app",
        "--reload",
        "--port",
        "8484"
      ],
      "cwd": "${workspaceFolder}",
      "env": {
        "CACHE_ENABLED": "false",
        "CACHE_DIR": "${workspaceFolder}/cache"
      },
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
